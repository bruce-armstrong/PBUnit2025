<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project>
  <Type Name="pb"/>
  <Application Name="orderstests"/>
  <DeployConfigurations OutputDirectory="Build\bin\$(ConfigurationName)">
    <DeployConfiguration Name="p_orderstests_exe" Path="tests\orderstests.pbl\p_orderstests_exe.srj"/>
  </DeployConfigurations>
  <Libraries AppEntry="tests\orderstests.pbl">
    <Library Path="tests\orderstests.pbl"/>
    <Library Path="tests\framework\pbunitrunner.pbl"/>
    <Library Path="tests\framework\pbunit.pbl"/>
    <Library Path="tests\framework\pbunitfunc.pbl"/>
    <Library Path="src\orders.pbl"/>
  </Libraries>
</Project>
