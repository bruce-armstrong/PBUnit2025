//objectcomments Orders for one customer
release 6;
datawindow(units=0 timer_interval=0 color=1090519039 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=58 color="536870912" )
table(column=(type=long updatewhereclause=yes key=yes name=order_id dbname="orders.order_id" )
 column=(type=long updatewhereclause=yes name=customer_id dbname="orders.customer_id" )
 column=(type=decimal(2) updatewhereclause=yes name=amount dbname="orders.amount" )
 retrieve="SELECT order_id, customer_id, amount FROM orders WHERE customer_id = :a_customer ORDER BY order_id" update="orders" updatewhere=0 updatekeyinplace=no arguments=(("a_customer", number)) )
column(band=detail id=1 alignment="1" tabsequence=10 border="0" color="33554432" x="4" y="3" height="51" width="300" format="[general]"  name=order_id edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=no  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
