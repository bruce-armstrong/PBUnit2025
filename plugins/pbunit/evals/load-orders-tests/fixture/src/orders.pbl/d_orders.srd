column(band=detail id=3 alignment="1" tabsequence=30 border="0" color="33554432" x="640" y="3" height="51" width="300" format="#,##0.00"  name=amount edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=no  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1090519039" )
